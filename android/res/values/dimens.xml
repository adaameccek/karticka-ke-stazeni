<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget: Widget.java z nich počítá velikost obrázku kódu, ať sedí na pixel s rozložením. -->
    <!-- řádek s názvem nahoře (text 2 dp od horního kraje) a řádek s číslem dole; v téhle výšce zakulacený roh
         launcheru usekne jen pár pixelů od kraje, o ty je kód od kraje dál -->
    <dimen name="w_radek">17dp</dimen>
    <dimen name="w_radek_nahore">2dp</dimen>
    <dimen name="w_cislo">12dp</dimen>
    <!-- rohy podle Vzhledu widgetu: rámeček (malé výchozí, jemné, kulaté, hranaté bez rohů) a bílá plocha kódu -->
    <dimen name="w_roh">9dp</dimen>
    <dimen name="w_panel_roh">7dp</dimen>
    <dimen name="w_roh_jemny">3dp</dimen>
    <dimen name="w_panel_roh_jemny">1dp</dimen>
    <dimen name="w_roh_kulaty">18dp</dimen>
    <dimen name="w_panel_roh_kulaty">16dp</dimen>
    <dimen name="w_nazev_text">11dp</dimen>
    <dimen name="w_nazev_text_min">7dp</dimen>
    <dimen name="w_cislo_text">10dp</dimen>
    <dimen name="w_cislo_text_min">6dp</dimen>
    <dimen name="w_slunce_dotyk">34dp</dimen>
    <!-- „Jsem v prodejně" ve velkém widgetu: řádek dole a tlačítko v něm (pod tlačítkem 8 dp kvůli rohům) -->
    <dimen name="w_tady_radek">34dp</dimen>
    <dimen name="w_tady">26dp</dimen>
    <!-- v nízkém widgetu menší tlačítko v řádku s názvem, vysoké jako písmo názvu (w_radek bez w_radek_nahore) -->
    <dimen name="w_tady_n">15dp</dimen>
</resources>
